# Optional environment configuration for DCF Analyzer
# Copy this file to .env if you want to override default settings.

# Default Risk-Free Rates (decimal format, e.g. 0.070 = 7.0%)
DEFAULT_US_RISK_FREE_RATE=0.042
DEFAULT_IN_RISK_FREE_RATE=0.070

# Default Equity Risk Premiums (decimal format)
DEFAULT_US_ERP=0.045
DEFAULT_IN_ERP=0.065

# Default Terminal Growth Rates (decimal format)
DEFAULT_US_TERMINAL_GROWTH=0.025
DEFAULT_IN_TERMINAL_GROWTH=0.040

# Cache TTL in seconds for yfinance requests
DATA_CACHE_TTL_SECONDS=900
